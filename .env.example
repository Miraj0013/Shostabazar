# ---------- App ----------
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ENCRYPTION_KEY=change-me-to-another-long-random-string
# Set to true only when the site is served over HTTPS
COOKIE_SECURE=false
# Set to 1 when running behind a reverse proxy (Nginx, Render, Railway...)
TRUST_PROXY=0

# ---------- MySQL ----------
DB_HOST=localhost
DB_PORT=3306
DB_USER=shostabazar
DB_PASSWORD=change-me
DB_NAME=shostabazar

# ---------- First admin account (created on first start) ----------
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@shostabazar.local
ADMIN_PASSWORD=change-this-to-a-strong-unique-password
SEED_DEMO_DATA=true

# ---------- Security tuning ----------
MAX_FAILED_ATTEMPTS=3
LOCK_MINUTES=15
SESSION_IDLE_MINUTES=15
SESSION_ABSOLUTE_HOURS=8
OTP_TTL_MINUTES=5
RESET_TTL_MINUTES=15
BCRYPT_ROUNDS=12
PASSWORD_MIN_LENGTH=8

# ---------- Email (SMTP). Leave SMTP_HOST empty to use the dev mailbox only ----------
# Gmail example: SMTP_HOST=smtp.gmail.com SMTP_PORT=465 SMTP_SECURE=true + an App Password
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="ShostaBazar Security <no-reply@shostabazar.local>"

# ---------- SMS via Twilio (optional) ----------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Shows sent emails/SMS at /dev/mailbox. NEVER enable on a public server.
DEV_MAILBOX=true
