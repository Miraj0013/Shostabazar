# Environment variables for the Netlify deployment.
# Netlify: Site configuration -> Environment variables -> Import from a .env file (paste this).
# Keep it short: AWS Lambda (Netlify Functions) allows only 4 KB of variables in total.

NODE_ENV=production
APP_URL=https://YOUR-SITE.netlify.app
COOKIE_SECURE=true
DEV_MAILBOX=false

# Long random strings (generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
SESSION_SECRET=
ENCRYPTION_KEY=

# Cloud MySQL (e.g. Aiven free MySQL). Use the values from the provider's connection info.
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=defaultdb
DB_SSL=true
# Aiven uses its own CA: download ca.pem into certs/ca.pem and commit it (it is public, not secret).
DB_SSL_CA_FILE=certs/ca.pem
DB_POOL_SIZE=3
DB_CONNECT_RETRIES=3

# First admin account (created on the first request)
ADMIN_USERNAME=admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Real email is REQUIRED (login codes). Gmail: turn on 2-Step Verification, then create an App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=ShostaBazar Security <YOUR_GMAIL@gmail.com>
