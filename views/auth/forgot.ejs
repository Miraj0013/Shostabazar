<%- include('../partials/header') %>
<section class="auth-card">
  <h1>Reset your password</h1>
  <% if (sent) { %>
    <div class="alert alert-success">If an account exists for that email, a reset link has been sent. It expires in 15 minutes and can be used only once.</div>
    <div class="auth-links"><a href="/login">← Back to sign in</a></div>
  <% } else { %>
    <p class="muted">Enter the email you registered with and we'll send you a secure, one-time reset link.</p>
    <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>
    <form method="post" action="/forgot" class="form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label>Email
        <input type="email" name="email" required maxlength="254" autocomplete="email" autofocus>
      </label>
      <button class="btn btn-block" type="submit">Send reset link</button>
    </form>
    <div class="auth-links"><a href="/login">← Back to sign in</a></div>
  <% } %>
</section>
<%- include('../partials/footer') %>
