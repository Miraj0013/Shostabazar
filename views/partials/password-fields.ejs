<label>New password
  <div class="pw-wrap">
    <input type="password" name="password" id="password" required minlength="8" maxlength="128" autocomplete="new-password" data-strength>
    <button type="button" class="pw-toggle" data-toggle="password" aria-label="Show password">👁</button>
  </div>
</label>
<div class="strength"><div class="strength-bar" id="strength-bar"></div></div>
<ul class="policy" id="policy">
  <li data-rule="length">At least 8 characters</li>
  <li data-rule="lower">A lowercase letter</li>
  <li data-rule="upper">An uppercase letter</li>
  <li data-rule="digit">A number</li>
  <li data-rule="special">A special character</li>
</ul>
<label>Confirm password
  <input type="password" name="confirm" id="confirm" required maxlength="128" autocomplete="new-password">
</label>
<small class="hint" id="match-hint"></small>
