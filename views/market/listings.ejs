<%- include('../partials/header') %>
<div class="section-head"><h1>My listings</h1><a class="btn" href="/products/new">+ New listing</a></div>
<% if (!products.length) { %>
  <p class="empty">You haven't listed anything yet.</p>
<% } else { %>
<div class="table-wrap">
<table class="table">
  <thead><tr><th>Item</th><th>Category</th><th>Price</th><th>Stock</th><th>Status</th><th></th></tr></thead>
  <tbody>
  <% products.forEach(function (p) { %>
    <tr>
      <td><a href="/products/<%= p.id %>"><%= p.title %></a></td>
      <td><%= p.category %></td>
      <td><%= money(p.price) %></td>
      <td><%= p.stock %></td>
      <td><span class="badge <%= p.is_active ? 'badge-ok' : 'badge-muted' %>"><%= p.is_active ? 'Active' : 'Removed' %></span></td>
      <td>
        <% if (p.is_active) { %>
        <form method="post" action="/products/<%= p.id %>/delete" data-confirm="Remove this listing?">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="btn btn-danger btn-sm" type="submit">Remove</button>
        </form>
        <% } %>
      </td>
    </tr>
  <% }) %>
  </tbody>
</table>
</div>
<% } %>
<%- include('../partials/footer') %>
