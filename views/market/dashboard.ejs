<%- include('../partials/header') %>
<section class="welcome">
  <div>
    <h1>Hi, <%= currentUser.username %> 👋</h1>
    <p class="muted">Find great deals or <a href="/products/new">list something to sell</a>.</p>
  </div>
  <div class="mini-stats">
    <a href="/listings"><strong><%= stats.listings %></strong><span>active listings</span></a>
    <a href="/orders"><strong><%= stats.orders %></strong><span>orders</span></a>
    <a href="/account"><strong><%= currentUser.totp_enabled ? 'App' : 'Email' %></strong><span>2FA method</span></a>
  </div>
</section>

<form class="searchbar" method="get" action="/dashboard" role="search">
  <input type="search" name="q" value="<%= q %>" placeholder="Search products, e.g. phone, saree, book…" maxlength="100" aria-label="Search products">
  <select name="category" aria-label="Category">
    <option value="">All categories</option>
    <% categories.forEach(function (c) { %><option value="<%= c %>" <%= c === category ? 'selected' : '' %>><%= c %></option><% }) %>
  </select>
  <select name="sort" aria-label="Sort">
    <option value="newest" <%= sort === 'newest' ? 'selected' : '' %>>Newest</option>
    <option value="price_asc" <%= sort === 'price_asc' ? 'selected' : '' %>>Price: low to high</option>
    <option value="price_desc" <%= sort === 'price_desc' ? 'selected' : '' %>>Price: high to low</option>
    <option value="title" <%= sort === 'title' ? 'selected' : '' %>>Name A–Z</option>
  </select>
  <button class="btn" type="submit">Search</button>
</form>

<div class="section-head">
  <h2><% if (q) { %>Results for “<%= q %>”<% } else { %>All products<% } %></h2>
  <span class="muted"><%= total %> item(s)</span>
</div>

<% if (!products.length) { %>
  <p class="empty">No products match your search.</p>
<% } else { %>
  <div class="product-grid">
    <% products.forEach(function (p) { %><%- include('../partials/product-card', { p }) %><% }) %>
  </div>
<% } %>

<% if (pages > 1) { %>
<nav class="pager">
  <% for (let i = 1; i <= pages; i++) { %>
    <a class="<%= i === page ? 'active' : '' %>" href="/dashboard?<%= new URLSearchParams({ q, category, sort, page: String(i) }).toString() %>"><%= i %></a>
  <% } %>
</nav>
<% } %>
<%- include('../partials/footer') %>
