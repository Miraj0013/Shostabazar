<%- include('../partials/header') %>
<a href="/dashboard" class="back">← Back to marketplace</a>
<section class="product-detail">
  <div class="product-thumb large cat-<%= product.category.toLowerCase() %>"><%= icon(product.category) %></div>
  <div class="panel">
    <span class="tag"><%= product.category %></span>
    <h1><%= product.title %></h1>
    <p class="price big"><%= money(product.price) %></p>
    <p class="description"><%= product.description %></p>
    <p class="muted">Sold by <strong><%= product.seller %></strong> · <%= product.stock %> in stock · listed <span data-utc="<%= new Date(product.created_at).toISOString() %>"></span></p>

    <% if (!product.is_active) { %>
      <div class="alert alert-warning">This listing has been removed.</div>
    <% } else if (product.seller_id === currentUser.id) { %>
      <div class="alert alert-info">This is your listing.</div>
    <% } else if (product.stock > 0) { %>
      <form method="post" action="/products/<%= product.id %>/buy" class="buy-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label>Qty <input type="number" name="quantity" value="1" min="1" max="<%= Math.min(product.stock, 100) %>" required></label>
        <button class="btn" type="submit">Buy now</button>
      </form>
    <% } else { %>
      <div class="alert alert-warning">Out of stock.</div>
    <% } %>

    <% if (product.is_active && (product.seller_id === currentUser.id || currentUser.role === 'admin')) { %>
      <form method="post" action="/products/<%= product.id %>/delete" data-confirm="Remove this listing?">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="btn btn-danger btn-sm" type="submit">Remove listing</button>
      </form>
    <% } %>
  </div>
</section>
<%- include('../partials/footer') %>
